<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_livestock_grade_list" model="ir.ui.view">
        <field name="name">livestock.grade.list</field>
        <field name="model">livestock.grade</field>
        <field name="arch" type="xml">
            <list>
                <field name="species_id"/>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_livestock_grade_form" model="ir.ui.view">
        <field name="name">livestock.grade.form</field>
        <field name="model">livestock.grade</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="species_id"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_livestock_grade" model="ir.actions.act_window">
        <field name="name">등급</field>
        <field name="res_model">livestock.grade</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
