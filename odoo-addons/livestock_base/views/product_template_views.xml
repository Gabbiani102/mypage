<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_livestock_inherit" model="ir.ui.view">
        <field name="name">product.template.form.livestock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='general_information']" position="inside">
                <field name="species_id"/>
                <field name="grade_id"/>
                <field name="origin_type"/>
                <field name="traceability_required"/>
                <field name="packaging_unit_id"/>
                <field name="shelf_life_days"/>
            </xpath>
        </field>
    </record>
</odoo>
